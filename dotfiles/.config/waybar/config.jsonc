{
    "layer": "bottom",
    "position": "top",
    "height": 24,
    "spacing": 6,
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 6,
    "margin-bottom": -6,
    "modules-left": ["group/power","pulseaudio/slider","pulseaudio"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["group/song","group/dashboard","clock","hyprland/language","tray"],

    "hyprland/window": {
        "format": "{title}",
        "icon": true
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-bluetooth": "B-{volume}%",
        "format-muted": "<i>muted</i>",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "clock": {
        "format": " {:%d/%m/%y - %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
    	"calendar": {
            "mode": "month",
            "mode-mon-col": 4,
            /*"weeks-pos": "right",*/
            "on-scroll": 1,
            "format": {
                "today": "<span color='#E45DFF'><b>{}</b></span>"
                /*"weeks": "<span color='#8000ff'><b>{}</b></span>"*/
            }
        },

        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    /* currently broken, thats why I removed it from group/arch */
    "image#arch": {
        "path": "/home/michele/.config/waybar/assets/archlinux_white.png",
        "size": 20
    },
    /* */

    "group/power": {
        "orientation": "horizontal",
        	"drawer": {
                "transition-duration": 500,
		        "transition-left-to-right": true
	    },
        "modules": [
            "custom/poweroff",
            "custom/reboot",
            "custom/logout",
            "custom/suspend",
            "custom/lockscreen"
        ]
    },

    "custom/poweroff": {
        "format": "⏻",
        "on-click": "~/scripts/waybar/poweroff_waybar.sh",
        "tooltip-format": "Poweroff"
    },
    
    "custom/reboot": {
        "format": "↺",
        "on-click": "~/scripts/waybar/reboot_waybar.sh",
        "tooltip-format": "Reboot"
    },
    

    "custom/logout": {
        "format": "←",
        "on-click": "~/scripts/waybar/logout_waybar.sh",
        "tooltip-format": "Logout"
    },
    
    "custom/suspend": {
        "format": "🌙",
        "on-click": "~/scripts/waybar/suspend_waybar.sh",
        "tooltip-format": "Suspend"
    },
    
    "custom/lockscreen": {
        "format": "🔒",
        "on-click": "hyprlock",
        "tooltip-format": "Lock screen"
    },

    "group/song": {
        "orientation": "horizontal",
        	"drawer": {
                "transition-duration": 300,
		        "transition-left-to-right": false,
                "click-to-reveal": true
	    },
        "modules": [
            "custom/song",
            "custom/songlength"
        ]
    },

    "custom/songlength": {
        "exec": "~/scripts/waybar/song_length_waybar.sh",
        "interval": 1,
        "exec-if": "playerctl -p spotify status | grep -q Playing"
    },

    "custom/song": {
        "exec": "playerctl -p spotify metadata --format '{{uc(title)}} - {{uc(artist)}}'",
        "interval": 1,
        "exec-if": "playerctl -p spotify status | grep -q Playing"
    },

    /*"custom/dlsort": {
        "exec": "~/scripts/dlsort_waybar.sh",
        "interval": 1,
        "on-click": "~/scripts/dlsort_check.sh",
        "tooltip-format": "Automatic-Download-Sorter" 
    },*/

    "hyprland/language": {
        "format-en": "US",
        "format-de": "DE"
    },

    "group/dashboard": {
        "orientation": "horizontal",
        	"drawer": {
                "transition-duration": 300,
		        "transition-left-to-right": false
	    },
        "modules": [
            "custom/dashboard",
            "custom/sysupdate",
            "custom/nightshift"
        ]


    },

    "custom/dashboard": {
        "format": "☰",
        "tooltip": false,
        "on-click": "swaync-client -t"
    },

    "custom/sysupdate": {
        "exec": "cat ~/.local/share/myutils/sysupdate/lastsysup.txt",
        "interval": 1,
        "format": "",
        "tooltip-format": "Last system-update: {}",
        "on-click": "kitty --title 'sysupdate' -e ~/scripts/sysupdate.sh"
    },

    "custom/nightshift": {
        "exec": "~/scripts/waybar/nightshift_waybar.sh",
        "interval": 1,
        "on-click": "~/scripts/nightshift.sh",
        "return-type": "json"
    }
}